{
  "name": "marvin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/browser-tests.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "password:hash": "tsx scripts/password.ts",
    "smoke:provider": "tsx scripts/provider-smoke.ts",
    "smoke:deployment": "tsx scripts/deployment-smoke.ts",
    "entire:setup": "tsx scripts/entire-setup.ts",
    "entire:check": "tsx scripts/entire-smoke.ts",
    "entire:companion": "tsx scripts/entire-companion.ts",
    "smoke:voice": "tsx scripts/voice-smoke.ts",
    "soak:device": "tsx scripts/device-soak.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "fastify": "5.12.4",
    "lucide-react": "1.45.0",
    "openai": "7.15.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
