+void LightStorage::light_directional_set_shadow_fixed_box(RID p_light, bool p_enable, float p_extent, float p_z_near, float p_z_far, int p_resolution) {
+	Light *light = light_owner.get_or_null(p_light);
+	ERR_FAIL_NULL(light);
+	ERR_FAIL_COND_MSG(p_enable && p_extent <= 0.0, "The extent of a fixed directional shadow box must be greater than zero.");
+	ERR_FAIL_COND_MSG(p_enable && p_z_far <= p_z_near, "The far plane of a fixed directional shadow box must be beyond its near plane.");
+
+	light->directional_fixed_box = p_enable;
+	light->directional_fixed_box_extent = p_extent;
+	light->directional_fixed_box_z_near = p_z_near;
+	light->directional_fixed_box_z_far = p_z_far;
+	light->directional_fixed_box_resolution = MAX(p_resolution, 0);
+	light->version++;
+	light->dependency.changed_notify(Dependency::DEPENDENCY_CHANGED_LIGHT);
+}
+
+bool LightStorage::light_directional_get_shadow_fixed_box(RID p_light, float &r_extent, float &r_z_near, float &r_z_far, int &r_resolution) const {
+	const Light *light = light_owner.get_or_null(p_light);
+	ERR_FAIL_NULL_V(light, false);
+
+	if (!light->directional_fixed_box) {
+		return false;
+	}
+	r_extent = light->directional_fixed_box_extent;
+	r_z_near = light->directional_fixed_box_z_near;
+	r_z_far = light->directional_fixed_box_z_far;
+	r_resolution = light->directional_fixed_box_resolution;
+	return true;
+}
+
+// Side of a fixed shadow box's square map in an atlas region: the region's shorter side, or less when the light asks
+// for a smaller map (a 2048 map in a 4096 x 8192 region keeps SceneKit's texel size for a 2048 shadowMapSize).
+static int _get_directional_fixed_box_size(const Size2i &p_region_size, int p_resolution) {
+	int size = MIN(p_region_size.width, p_region_size.height);
+	if (p_resolution > 0) {
+		size = MIN(size, p_resolution);
+	}
+	return MAX(size, 1);
+}
+
+Rect2 LightStorage::light_directional_get_fixed_box_rect(RID p_light, const Rect2 &p_region) const {
+	const Light *light = light_owner.get_or_null(p_light);
+	if (!light || light->type != RSE::LIGHT_DIRECTIONAL || !light->directional_fixed_box) {
+		return p_region;
+	}
+	const int size = _get_directional_fixed_box_size(Size2i(p_region.size), light->directional_fixed_box_resolution);
+	return Rect2(p_region.position, Vector2(size, size));
+}
