+
+// Fixed directional shadow box (RenderingServer.light_directional_set_shadow_fixed_box): shadow_box_rect holds the
+// light's map in the atlas as two 16-bit unorm pairs, (min.x | min.y << 16, max.x | max.y << 16). Unpacked with
+// integer operations rather than unpackUnorm2x16(), so every shader backend (SPIRV-Cross for Metal, NIR/DXIL for
+// D3D12) sees only plain ALU.
+vec4 directional_shadow_box_rect(uvec2 box_rect) {
+	return vec4(uvec4(box_rect.x & 0xFFFFu, box_rect.x >> 16u, box_rect.y & 0xFFFFu, box_rect.y >> 16u)) * (1.0 / 65535.0);
+}
+
+// The light's only map covers a box anchored to the light, so receivers outside it (beyond the map's rect in the
+// atlas, in front of its near plane or beyond its far plane) are unshadowed. pssm_coord: the receiver's coordinates in
+// the atlas after the perspective divide (depth 1 at the near plane, 0 at the far plane).
+bool directional_shadow_box_outside(uvec2 box_rect, vec3 pssm_coord) {
+	if (box_rect.y == 0u) {
+		return false;
+	}
+	vec4 rect = directional_shadow_box_rect(box_rect);
+	return any(lessThan(pssm_coord.xy, rect.xy)) || any(greaterThan(pssm_coord.xy, rect.zw)) || pssm_coord.z < 0.0 || pssm_coord.z > 1.0;
+}
+
+// The rect PCF taps are clamped to: half a texel inside a fixed shadow box's map, so its kernel never reads a
+// neighbouring map in the atlas; the whole atlas for other lights.
+vec4 directional_shadow_box_clamp_rect(uvec2 box_rect, vec2 atlas_pixel_size) {
+	if (box_rect.y == 0u) {
+		return vec4(0.0, 0.0, 1.0, 1.0);
+	}
+	return directional_shadow_box_rect(box_rect) + vec4(0.5 * atlas_pixel_size, -0.5 * atlas_pixel_size);
+}
