+// GLSL packUnorm2x16(): x in the low 16 bits, y in the high 16 bits.
+static uint32_t _pack_unorm_2x16(const Vector2 &p_value) {
+	const uint32_t x = uint32_t(Math::round(CLAMP(p_value.x, (real_t)0.0, (real_t)1.0) * (real_t)65535.0));
+	const uint32_t y = uint32_t(Math::round(CLAMP(p_value.y, (real_t)0.0, (real_t)1.0) * (real_t)65535.0));
+	return x | (y << 16);
+}
