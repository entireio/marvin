+// Fixed-kernel directional PCF (rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_kernel 1-3):
+// every pixel takes the same taps, each a hardware bilinear depth comparison (directional_soft_shadow_kernel holds
+// point-symmetric rings of four taps, outermost ring first, see get_fixed_ring_disk()). Unlike
+// sample_directional_pcf_shadow() there is no per-pixel rotation: no hash, no sin/cos, no rotation matrix and no noise,
+// which keeps the filter's register footprint close to the hard filter's.
+// clamp_rect keeps the taps inside the light's own map (fixed shadow boxes); vec4(0, 0, 1, 1) for other lights.
+// early_out: when the outer ring's four taps agree, the pixel is taken as fully lit or fully shadowed and the other taps
+// are skipped. This can miss shadows thinner than the gap between those four taps.
+// runtime_loop: the sample count comes from the kernel itself (the first tap's w, see get_fixed_ring_disk()) instead of
+// the specialization constant, so the compiler cannot unroll the loop and keeps fewer taps in flight and fewer
+// registers live. This is the shape of SceneKit's own PCF loop (ComputeSoftShadow: a uniform sample count, a fixed
+// kernel). Unrolling cannot be prevented otherwise on Metal: SPIRV-Cross drops [[dont_unroll]] when it emits MSL.
+half sample_directional_pcf_shadow_fixed(texture2D shadow, vec2 shadow_pixel_size, vec4 coord, vec4 clamp_rect, bool early_out, bool runtime_loop) {
+	vec2 pos = coord.xy;
+	float depth = coord.z;
+	uint sample_count = runtime_loop ? max(uint(scene_data_block.data.directional_soft_shadow_kernel[0].w), 1u) : sc_directional_soft_shadow_samples();
+
+	float avg = 0.0;
+	uint first = 0u;
+
+	if (early_out && sample_count > 4u) {
+		for (uint i = 0u; i < 4u; i++) {
+			vec2 tap = clamp(pos + shadow_pixel_size * scene_data_block.data.directional_soft_shadow_kernel[i].xy, clamp_rect.xy, clamp_rect.zw);
+			avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(tap, depth, 1.0));
+		}
+		if (avg < 0.001 || avg > 3.999) {
+			return half(avg * 0.25);
+		}
+		first = 4u;
+	}
+
+	SPEC_CONSTANT_LOOP_ANNOTATION
+	for (uint i = first; i < sample_count; i++) {
+		vec2 tap = clamp(pos + shadow_pixel_size * scene_data_block.data.directional_soft_shadow_kernel[i].xy, clamp_rect.xy, clamp_rect.zw);
+		avg += textureProj(sampler2DShadow(shadow, shadow_sampler), vec4(tap, depth, 1.0));
+	}
+
+	return half(avg * (1.0 / float(sample_count)));
+}
+
+// Directional PCF with the kernel selected by kernel_mode (sc_directional_soft_shadow_kernel() where the renderer has
+// it): 0 the per-pixel rotated Vogel disk, 1 the fixed kernel, 2 the fixed kernel with early out, 3 the fixed kernel
+// with a runtime loop.
+half sample_directional_pcf_shadow_kernel(texture2D shadow, vec2 shadow_pixel_size, vec4 coord, float taa_frame_count, uint kernel_mode, vec4 clamp_rect) {
+	if (kernel_mode != 0u && sc_directional_soft_shadow_samples() != 0u) {
+		return sample_directional_pcf_shadow_fixed(shadow, shadow_pixel_size, coord, clamp_rect, kernel_mode == 2u, kernel_mode == 3u);
+	}
+	return sample_directional_pcf_shadow(shadow, shadow_pixel_size, coord, taa_frame_count);
+}
