+
+// Kernel for the fixed (unrotated) directional PCF filter: rings of four taps at equal-area radii, each ring rotated by
+// the golden angle against the previous one. Every ring is point-symmetric, so the kernel's centroid is exactly zero and
+// shadow edges do not shift (an unrotated Vogel disk is lopsided). The outermost ring comes first, so the first four taps
+// can classify fully lit and fully shadowed pixels (early out). Fewer than four samples use the centre.
+void get_fixed_ring_disk(float *r_kernel, int p_sample_count) {
+	const float golden_angle = 2.4;
+
+	if (p_sample_count < 4) {
+		for (int i = 0; i < p_sample_count; i++) {
+			r_kernel[i * 4] = 0.0;
+			r_kernel[i * 4 + 1] = 0.0;
+		}
+		return;
+	}
+
+	const int rings = p_sample_count / 4;
+	for (int ring = 0; ring < rings; ring++) {
+		const int j = rings - 1 - ring; // Outermost ring first.
+		const float r = Math::sqrt((float(j) + 0.5) / float(rings));
+		const float theta = float(Math::PI) * 0.125f + float(j) * golden_angle;
+		for (int k = 0; k < 4; k++) {
+			const int i = ring * 4 + k;
+			const float a = theta + float(k) * float(Math::PI) * 0.5f;
+			r_kernel[i * 4] = Math::cos(a) * r;
+			r_kernel[i * 4 + 1] = Math::sin(a) * r;
+		}
 	}
 }
 
