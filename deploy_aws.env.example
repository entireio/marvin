# Settings for ./deploy_aws.sh — copy to deploy_aws.env and edit.
#
# This file names people and resources, not secrets. API keys and the GitHub
# client secret go into AWS Secrets Manager via the script's --set-*-key flags
# and are never written here.

# --- Required -------------------------------------------------------------

# Client ID of the GitHub OAuth App. Its callback URL must be
# https://<your domain>/auth/callback
GITHUB_CLIENT_ID=Iv1.yourclientid

# An ACM certificate for the domain you will serve from, in the same region.
# The robot verifies TLS against a real certificate authority, so a self-signed
# certificate will not do.
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx

# The ALB sees its own hostname rather than yours, so unlike on Cloud Run this
# has to be stated.
BASE_URL=https://marvin.example.com

# --- Access — at least one is required ------------------------------------

ALLOWED_GITHUB_USERS=your-github-login
# ALLOWED_GITHUB_ORGS=your-org
# ALLOW_ANY_GITHUB_USER=true

# --- Optional -------------------------------------------------------------

# AWS_REGION=us-east-1
# CLUSTER=marvin
# SERVICE=marvin
# ECR_REPO=marvin
# VPC_ID=vpc-xxxxxxxx
# SUBNET_IDS=subnet-aaaa,subnet-bbbb
# SESSION_TTL_HOURS=12

# Voice. Without a key stored by --set-openai-key or --set-gemini-key the site
# and controller work but the robot cannot hold a conversation.
# AI_PROVIDER=openai
# AI_MODEL=
# AI_VOICE=
# DEVICE_TOKEN_TTL_DAYS=365
