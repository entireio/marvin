# Copy to .env. Never commit credentials. Defaults are an explicit local demo.
HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://127.0.0.1:5173
AUTH_MODE=development
MODEL_PROVIDER=fixture
SQLITE_PATH=./data/marvin.sqlite
# Set for PostgreSQL instead of SQLite:
# DATABASE_URL=postgresql://marvin:password@localhost:5432/marvin
# Real provider (M3 live evidence requires an API key AND a model):
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional stronger text model when a real repository is connected:
# OPENAI_REPOSITORY_MODEL=
# Local password auth: npm run password:hash, then paste the generated hash here.
# AUTH_MODE=local
# LOCAL_PASSWORD_HASH=
# Standards-based identity; configure only with an approved client registration.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-approved-issuer.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Your identity provider
# OIDC_REDIRECT_URI=http://127.0.0.1:4310/api/auth/callback
# Production requires HTTPS APP_ORIGIN, secure cookies, local/oidc auth and real provider.
# NODE_ENV=production
PUBLIC_DOCS_URL=https://spedemon.github.io/marvin/
# Optional local Entire adapter (run npm run entire:setup in your logged-in terminal).
# Both paths are required together. Incompatible with hosted AUTH_MODE=oidc.
# ENTIRE_CLI_PATH=/absolute/path/to/entire
# ENTIRE_BINDINGS_FILE=/absolute/path/to/data/entire-bindings.json

# Realtime web voice (server-side credentials; disabled by default).
# VOICE_PROVIDER=openai
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_VOICE=marin
# Tested text candidate: OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Use only with one controlled reverse proxy and an inaccessible backend port.
# TRUST_PROXY_HOPS=1

# Enable only after validating owner firmware and deployment trust on hardware.
HARDWARE_PROVISIONING_ENABLED=false

# Optional second speech provider; canonical reasoning uses MODEL_PROVIDER.
# VOICE_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Optional operator-approved firmware rollout; absent means no updates offered.
# Absolute JSON path with publicKeyFile, bundleDirectory and explicit deviceIds.
# FIRMWARE_ROLLOUT_FILE=/run/marvin/firmware-rollout.json
