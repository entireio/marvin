# Settings for ./deploy_google_cloud.sh
#
# Copy to deploy_google_cloud.env — which is gitignored — and edit. No secrets
# belong in here: the GitHub client secret and the cookie signing key live in
# Secret Manager, and the deploy script puts them there for you.
#
# Run ./deploy_google_cloud.sh --help for the full list.

# --- required -------------------------------------------------------------

# Client ID of your GitHub OAuth App (https://github.com/settings/developers).
GITHUB_CLIENT_ID=Iv1.0123456789abcdef

# Google Cloud project to deploy into. Defaults to your active gcloud project.
PROJECT_ID=my-gcp-project

# --- access: at least one of these ----------------------------------------
# With none of them set the server refuses to start, rather than quietly
# admitting every GitHub account on earth.

# GitHub logins that may read the site.
ALLOWED_GITHUB_USERS=spedemon

# Members of these GitHub organisations may read the site. Asking for this
# widens the OAuth consent screen to include read:org, so leave it out unless
# you use it.
# ALLOWED_GITHUB_ORGS=my-org

# Admit any GitHub account. Anyone can make one in a minute, so this is close
# to publishing the site.
# ALLOW_ANY_GITHUB_USER=true

# --- optional -------------------------------------------------------------

# REGION=us-central1
# SERVICE=marvin-site
# SESSION_TTL_HOURS=12

# Only needed behind a custom domain. The server works out its own origin from
# the request otherwise.
# BASE_URL=https://marvin.example.com
