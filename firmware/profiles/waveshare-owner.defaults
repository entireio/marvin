CONFIG_MARVIN_OWNER_ENROLLMENT=y
CONFIG_MARVIN_BODY_AUDIO=y
CONFIG_MARVIN_SILENT_TEST=y
# Security2 plus signed owner/recovery challenges execute on the NimBLE host.
# Keep the release profile aligned with the already-proven local profile.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Duplex audio must not serialize microphone writes behind reply reads.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
