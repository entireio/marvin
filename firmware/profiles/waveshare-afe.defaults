CONFIG_MARVIN_LOCAL_AFE=y
CONFIG_MARVIN_SILENT_TEST=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-afe.csv"
# CONFIG_SR_WN_WN9_HIESP is not set
CONFIG_SR_MN_CN_NONE=y
# CONFIG_SR_MN_EN_NONE is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

CONFIG_MARVIN_HEY_MARVIN_WAKE=y
CONFIG_MARVIN_MICRO_WAKE_WORD=y
CONFIG_MARVIN_WAKE_WINDOW=3
CONFIG_MARVIN_WAKE_PROBABILITY_CUTOFF=128
# CONFIG_SR_MN_EN_MULTINET5_SINGLE_RECOGNITION_QUANT8 is not set
# Keep one Espressif model in the model partition because ESP-SR's AFE loader
# requires a nonempty model list. The dedicated microWakeWord remains the only
# wake decision path when CONFIG_MARVIN_MICRO_WAKE_WORD is enabled.
CONFIG_SR_MN_EN_MULTINET6_QUANT=y
# CONFIG_SR_MN_EN_NONE is not set
