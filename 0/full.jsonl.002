{"timestamp":"2026-10-03T14:01:58.518Z","ordinal":18354,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":190473088,"cached_input_tokens":187891712,"cache_write_input_tokens":0,"output_tokens":462472,"reasoning_output_tokens":180837,"total_tokens":190935560},"last_token_usage":{"input_tokens":183769,"cached_input_tokens":182144,"cache_write_input_tokens":0,"output_tokens":429,"reasoning_output_tokens":288,"total_tokens":184198},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":36.0,"window_minutes":10080,"resets_at":1791583133},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"63618.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
