5,1.8)]\n    public static func laneDistance(_ p:SIMD2<Double>)->Double {\n        zip(serviceLane,serviceLane.dropFirst()).map { a,b in\n            let d=b-a,t=max(0,min(1,simd_dot(p-a,d)/simd_length_squared(d)))\n            return simd_length(p-a-d*t)\n        }.min()!\n    }\n''')\ns=s.replace('''guard !(z < -4 && x > -8.6 && x < -4.6),\n                  hypot((x+7.5)/2.9,(z+7.5)/2.9)>1,''','''guard laneDistance(SIMD2(x,z))>1.35,\n                  hypot((x-tentOrigins[0].x)/2.7,(z-tentOrigins[0].y)/2.7)>1,''')\ns=s.replace('Canopy(points:[SIMD2(-9.5,-9.5),SIMD2(-9.5,-5.5),SIMD2(-6.3,-5.5)],low:1.97,high:2.32)','Canopy(points:orangeCorners.map{tentOrigins[0]+$0},low:1.97,high:2.32)')\ns=s.replace('for (i,origin) in [SIMD2(-7.5,-7.5),SIMD2(-8.5,3.5)].enumerated()','for (i,origin) in tentOrigins.enumerated()')\ns=s.replace('i==0 ? [SIMD2(-2.0,-2.0),SIMD2(-2.0,2.0),SIMD2(1.2,2.0)] :','i==0 ? orangeCorners :')\ns=s.replace('i==0 ? -0.4:0','i==0 ? -0.1:0').replace('i==0 ? 0.85:0)','i==0 ? 0.35:0)')\np.write_text(s)\np=Path('apps/simulator-macos/Sources/MarvinSimulator/TownWorld.swift');s=p.read_text()\ns=s.replace('for (i,location) in [(-7.5,-7.5),(-8.5,3.5)].enumerated() {\\n            let x=location.0,z=location.1,w=4.0,d=4.0','for (i,location) in InfieldLayout.tentOrigins.enumerated() {\\n            let x=location.x,z=location.y,w=i==0 ? 3.2:4.0,d=i==0 ? 3.2:4.0')\ns=s.replace('p.repairRug(3.8,3.8,i)','p.repairRug(w-0.2,d-0.2,i)').replace('p=paint(x-0.4,z+0.85)','p=paint(x-0.1,z+0.35)')\ns=s.replace('x+(i==0 ? -2.025:0)','x+(i==0 ? -1.625:0)')\ns=s.replace('''        for z in [-7.5,3.5] {\n            let x = z<0 ? -7.9:-8.5,p=paint(x,z+(z<0 ? 0.85:0))''','''        for (i,origin) in InfieldLayout.tentOrigins.enumerated() {\n            let z=origin.y,p=paint(origin.x+(i==0 ? -0.1:0),z+(i==0 ? 0.35:0))''')\ns=s.replace('let q=paint(-7.9,-6.65)','let q=paint(InfieldLayout.tentOrigins[0].x-0.1,InfieldLayout.tentOrigins[0].y+0.35)')\ns=s.replace('let corners:[SIMD3<Double>]=[SIMD3(-2,2,-2),SIMD3(-2,2,2),SIMD3(1.2,2,2)]','let corners=InfieldLayout.orangeCorners.map { SIMD3<Double>($0.x,2,$0.y) }').replace('let center=point(-0.67,2.3,0.67)','let center=point(-0.6,2.3,0.53)')\np.write_text(s)\np=Path('apps/simulator-macos/Tests/SimulationCoreTests/InfieldCollisionChecks.swift');s=p.read_text();a=s.index('        let route:');b=s.index('\\n',a);s=s[:a]+'        let route=InfieldLayout.serviceLane'+s[b:];s=s.replace('SIMD3<Double>(-8.8,0,-7)','SIMD3<Double>(-9,0,-7)').replace('SIMD3<Double>(-8.8,2,-7)','SIMD3<Double>(-9,2,-7)');p.write_text(s)\nPY\napps/simulator-macos/build-app.sh > /tmp/marvin-salvage-build.log 2>&1\nDEVELOPER_DIR=/Library/Developer/CommandLineTools swift run -c release --package-path apps/simulator-macos SimulationChecks > /tmp/marvin-salvage-tests.log 2>&1"],["/bin/zsh","-lc","python3 - <<'PY'\nfrom pathlib import Path\np=Path('apps/simulator-macos/Sources/SimulationCore/RobotCollisions.swift');s=p.read_text();a=s.index('    private static func effectiveMass')\ns=s[:a]+'''    /// Convex, elevated canopy envelope. SAT uses actual footprint edges, so\n    /// the missing triangular corner remains traversable at every height.\n    public static func canopyContact(_ body:Body, footprint:[SIMD2<Double>], low:Double, high:Double)->Contact? {\n        guard body.position.y<high,body.position.y+body.profile.height>low else { return nil }\n        var axes:[SIMD2<Double>]=body.profile.round ? []:[body.lateral,body.forward]\n        for i in footprint.indices {\n            let d=footprint[(i+1)%footprint.count]-footprint[i]\n            axes.append(simd_normalize(SIMD2(-d.y,d.x)))\n            if body.profile.round {\n                let v=footprint[i]-body.center\n                if simd_length_squared(v)>1e-10 { axes.append(simd_normalize(v)) }\n            }\n        }\n        var depth=Double.infinity,normal=SIMD3<Double>.zero\n        for axis in axes {\n            let values=footprint.map { simd_dot($0,axis) },c=simd_dot(body.center,axis),extent=body.extent(axis)\n            let left=c+extent-values.min()!,right=values.max()!-c+extent\n            guard left>0,right>0 else { return nil }\n            if min(left,right)<depth {\n                depth=min(left,right);let n=axis*(left<right ? 1.0:-1.0)\n                normal=SIMD3(n.x,0,n.y)\n            }\n        }\n        let below=body.position.y+body.profile.height-low,above=high-body.position.y\n        if min(below,above)<depth { depth=min(below,above);normal=SIMD3(0,below<above ? 1:-1,0) }\n        return Contact(normal:normal,point:body.position,penetration:depth)\n    }\n\n'''+s[a:]\nneedle='''                for obstacle in InfieldLayout.obstacles {'''\n# add roofs after obstacle loop via known closing sequence\nold='''                    if inward>0 { bodies[i].velocity -= c.normal*inward }\n                }\n            } }'''\nnew='''                    if inward>0 { bodies[i].velocity -= c.normal*inward }\n                }\n                for canopy in InfieldLayout.canopies {\n                    guard let c=canopyContact(bodies[i],footprint:canopy.points,low:canopy.low,high:canopy.high) else { continue }\n                    worstOverlap=max(worstOverlap,c.penetration);bodies[i].contacted=true\n                    bodies[i].position -= c.normal*(c.penetration+0.00001)\n                    let inward=simd_dot(bodies[i].velocity,c.normal)\n                    if inward>0 { bodies[i].velocity -= c.normal*inward }\n                }\n            } }'''\ns=s.replace(old,new);p.write_text(s)\np=Path('apps/simulator-macos/Sources/SimulationCore/InfieldLayout.swift');s=p.read_text().replace('    public static let obstacles:', '''    public struct Canopy:Sendable {\n        public let points:[SIMD2<Double>]\n        public let low,high:Double\n    }\n    public static let canopies=[\n        Canopy(points:[SIMD2(-9.5,-9.5),SIMD2(-9.5,-5.5),SIMD2(-5.5,-5.5)],low:1.97,high:2.32),\n        Canopy(points:[SIMD2(-10.5,1.5),SIMD2(-10.5,5.5),SIMD2(-6.5,5.5),SIMD2(-6.5,1.5)],low:1.97,high:2.67)\n    ]\n    public static let obstacles:''');p.write_text(s)\nPY\napps/simulator-macos/build-app.sh > /tmp/marvin-salvage-build.log 2>&1"],["/bin/zsh","-lc","python3 - <<'PY'\nfrom pathlib import Path\np=Path('apps/simulator-macos/Tests/SimulationCoreTests/InfieldCollisionChecks.swift');s=p.read_text().replace('''                    near(bodies[0].position.x,p.x,accuracy:0.001)''','''                    if abs(bodies[0].position.x-p.x)>0.001 || abs(bodies[0].position.z-p.y)>0.001 { print(\"Blocked route: \\\\(p), heading \\\\(heading), result \\\\(bodies[0].position), chassis \\\\(profile.halfWidth)\") }\n                    near(bodies[0].position.x,p.x,accuracy:0.001)''');p.write_text(s)\nPY\nDEVELOPER_DIR=/Library/Developer/CommandLineTools swift run -c release --package-path apps/simulator-macos SimulationChecks > /tmp/marvin-salvage-tests.log 2>&1"],["/bin/zsh","-lc","python3 - <<'PY'\nfrom pathlib import Path\np=Path('apps/simulator-macos/Tests/SimulationCoreTests/InfieldCollisionChecks.swift');s=p.read_text().replace('SIMD3<Double>(-7.8,2,-9.8)','SIMD3<Double>(-7.8,2,-7.4)').replace('let pole=InfieldLayout.obstacles[0]','let pole=InfieldLayout.obstacles.first { abs($0.position.x+6.5)<0.001 && abs($0.position.z-1.5)<0.001 }!');p.write_text(s)\nPY\nDEVELOPER_DIR=/Library/Developer/CommandLineTools swift run -c release --package-path apps/simulator-macos SimulationChecks > /tmp/marvin-salvage-tests.log 2>&1"],["/bin/zsh","-lc","python3 - <<'PY'\nfrom pathlib import Path\np=Path('apps/simulator-macos/Tests/SimulationCoreTests/InfieldCollisionChecks.swift');s=p.read_text();a=s.index('''            // Continuous 240 Hz''');s=s[:a]+'''            // Turning and reversing must fit too, not just facing each segment.\n            for p in route { for turn in 0..<24 {\n                var bodies=[RobotCollisions.Body(position:SIMD3(p.x,DirtCourse.height(x:p.x,z:p.y),p.y),heading:Double(turn)*Double.pi/12,profile:profile)]\n                _=RobotCollisions.resolve(&bodies,terrain:true,betweenRobots:false)\n                near(bodies[0].position.x,p.x,accuracy:0.001)\n                near(bodies[0].position.z,p.y,accuracy:0.001)\n            }}\n'''+s[a:]\ns=s.replace('''        print(\"PASS: triangular tent aisle''','''        // A narrow pole must stop an approaching robot but allow backing away.\n        let pole=InfieldLayout.obstacles[0]\n        var probe=[RobotCollisions.Body(position:pole.position+SIMD3(0.29,0,0),velocity:SIMD3(-8,0,0),profile:profile)]\n        _=RobotCollisions.resolve(&probe,terrain:true,betweenRobots:false)\n        require(probe[0].contacted)\n        require(RobotCollisions.contact(probe[0],pole)==nil)\n        let before=probe[0].position\n        probe[0].velocity=SIMD3(1,0,0);probe[0].position.x += 0.05\n        _=RobotCollisions.resolve(&probe,terrain:true,betweenRobots:false)\n        require(probe[0].position.x>before.x)\n        print(\"PASS: triangular tent aisle''');p.write_text(s)\nPY\nDEVELOPER_DIR=/Library/Developer/CommandLineTools swift run -c release --package-path apps/simulator-macos SimulationChecks > /tmp/marvin-salvage-tests.log 2>&1"],["claude"],["entire","provenance"],["entire","provenance","index"],["git","clone"],["git","pull"],["git","push"],["git","status","--short"]]},"persistent_mode":{},"personality":{"model":"gpt-6-astra","personality":"pragmatic"},"plugins_instructions":false,"realtime":{"active":false},"skills":{"includeInstructions":true}}}}
