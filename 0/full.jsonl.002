marvin.enumerateChildNodes { node,_ in\n            if let name=node.name,internalNames.contains(name) { internalNodes.append((node,node.isHidden)) }\n        }''');s=s.replace('            marvin.isHidden=marvinHidden\\n','            marvin.isHidden=marvinHidden\\n            for (node,hidden) in internalNodes { node.isHidden=hidden }\\n');s=s.replace('            marvin.isHidden=marvinHidden || variant==\"no-marvin\"','''            marvin.isHidden=marvinHidden || variant==\"no-marvin\"\n            for (node,hidden) in internalNodes { node.isHidden=hidden || variant==\"marvin-no-internals\" }''');open(p,'w').write(s)\nPY\napps/simulator-macos/build-app.sh > /Users/thomi/Projects/marvin-town-planning/sustained-fix/marvin-internals-build.log 2>&1"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":63,"nanos":708132083},"formatted_output":""},"started_at_ms":1791032389096,"completed_at_ms":1791032452804}}
