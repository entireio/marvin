{"timestamp":"2026-10-03T12:55:09.933Z","ordinal":17197,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":173145383,"cached_input_tokens":170829440,"cache_write_input_tokens":0,"output_tokens":419917,"reasoning_output_tokens":168027,"total_tokens":173565300},"last_token_usage":{"input_tokens":44690,"cached_input_tokens":44288,"cache_write_input_tokens":0,"output_tokens":162,"reasoning_output_tokens":10,"total_tokens":44852},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":33.0,"window_minutes":10080,"resets_at":1791583130},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"63618.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
