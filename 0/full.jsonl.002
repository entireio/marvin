{"timestamp":"2026-10-03T13:12:38.595Z","ordinal":17592,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":177514580,"cached_input_tokens":175147008,"cache_write_input_tokens":0,"output_tokens":431591,"reasoning_output_tokens":170221,"total_tokens":177946171},"last_token_usage":{"input_tokens":93797,"cached_input_tokens":90752,"cache_write_input_tokens":0,"output_tokens":386,"reasoning_output_tokens":270,"total_tokens":94183},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":34.0,"window_minutes":10080,"resets_at":1791583132},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"63618.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
