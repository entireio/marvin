              }\n                nodeTriangles += element.primitiveCount\n            }\n            primitiveCount += nodeTriangles\n            inputElements += source.elements.count\n            vertexCount += count\n            rows.append([\"ordinal\": ordinal, \"vertices\": count, \"triangles\": nodeTriangles,\n                         \"currentToBelt\": Self.values(current), \"initialToBody\": Self.values(reference)])\n        }\n        var sources = zip(layout, output).map { source, data in\n            SCNGeometrySource(data: data, semantic: source.semantic, vectorCount: vertexCount,\n                              usesFloatComponents: true, componentsPerVector: source.componentsPerVector,\n                              bytesPerComponent: 4, dataOffset: 0, dataStride: source.componentsPerVector * 4)\n        }\n        sources.append(SCNGeometrySource(data: rest, semantic: .color, vectorCount: vertexCount,\n                                         usesFloatComponents: true, componentsPerVector: 4,\n                                         bytesPerComponent: 4, dataOffset: 0, dataStride: 16))\n        let element = SCNGeometryElement(indices: indices, primitiveType: .triangles)\n        let geometry = SCNGeometry(sources: sources, elements: [element])\n        geometry.materials = [material]\n        geometry.shaderModifiers = [.geometry: Self.geometryModifier,\n            .surface: surface.replacingOccurrences(of: Self.referenceLine,\n                       with: \"float3 p = in.trackFrozenRestBody / dirtHeight;\")]\n        for key in Self.uniformKeys { geometry.setValue(first.value(forKey: key), forKey: key) }\n        let batch = SCNNode(geometry: geometry)\n        batch.name = name; batch.isHidden = true\n        batch.castsShadow = firstNode.castsShadow\n        batch.categoryBitMask = firstNode.categoryBitMask\n        batch.renderingOrder = firstNode.renderingOrder\n        return Built(parent: parent, node: batch, row: [\n            \"name\": name, \"inputNodes\": nodes.count, \"inputElements\": inputElements,\n            \"outputNodes\": 1, \"outputElements\": 1, \"vertices\": vertexCount,\n            \"triangles\": primitiveCount, \"triangleCountPreserved\": indices.count == primitiveCount * 3,\n            \"allOriginalVerticesRetained\": true, \"indicesOnlyRebasedInOriginalNodeElementTriangleOrder\": true,\n            \"untouchedAttributeBytesCopied\": true,\n            \"maxPositionComponentErrorVsDouble\": positionError,\n            \"maxNormalComponentErrorVsDouble\": normalError,\n            \"maxTangentComponentErrorVsDouble\": tangentError,\n            \"maxRestBodyComponentErrorVsDouble\": restError,\n            \"poses\": rows])\n    }\n\n    private static func validateGeometry(_ geometry: SCNGeometry) throws {\n        try check(geometry.program == nil && geometry.tessellator == nil && geometry.subdivisionLevel == 0 &&\n                  (geometry.levelsOfDetail?.isEmpty ?? true), \"Program, tessellation, subdivision or LOD is unsupported\")\n        guard let modifiers = geometry.shaderModifiers, modifiers.count == 1,\n","exit_code":0,"duration":{"secs":0,"nanos":3292},"formatted_output":"import AppKit\nimport SceneKit\nimport simd\n\n/// FROZEN-POSE DIAGNOSTIC ONLY. No animation/update path and no game default.\n/// Build after DirtCoating.install and after the native renderer has settled.\n/// Keep simulation stopped while this object exists. Camera/root motion is OK;\n/// shoe/rib local transforms and geometry must remain the captured pose.\nfinal class TrackBatchProbe {\n    enum Mode: String { case original, copyControl, batch }\n    struct Failure: Error, CustomStringConvertible {\n        let description: String\n        init(_ description: String) { self.description = description }\n    }\n    private struct Original {\n        let node: SCNNode\n        let geometry: SCNGeometry\n        let copy: SCNGeometry\n        let transform: simd_float4x4\n        let hidden: Bool\n    }\n    private struct Built {\n        let parent: SCNNode\n        let node: SCNNode\n        let row: [String: Any]\n    }\n    private var originals: [Original] = []\n    private var batches: [Built] = []\n    private(set) var mode: Mode = .original\n    private static let uniformKeys = [\"dirtToBody\", \"dirtHeight\", \"dirtWheelX\", \"duneContact\", \"dirtRolling\"]\n    private static let referenceLine = \"float3 p = (dirtToBody * float4(local,1.0)).xyz / dirtHeight;\"\n    private static let geometryModifier = \"\"\"\n    #pragma varyings\n    float3 trackFrozenRestBody;\n    #pragma body\n    out.trackFrozenRestBody = _geometry.color.xyz;\n    _geometry.color = float4(1.0);\n    \"\"\"\n\n    init(root: SCNNode, tracks: [TrackBelt]) throws {\n        try Self.check(tracks.count == 2, \"Expected two native TrackBelt instances\")\n        var seen = Set<ObjectIdentifier>()\n        var pending: [Built] = []\n        for (beltIndex, belt) in tracks.enumerated() {\n            try Self.check(belt.node.parent === root && belt.shoes.count == 56,\n                           \"Unexpected belt parent or shoe count\")\n            try Self.check(!belt.node.isHidden && belt.node.opacity == 1,\n                           \"Hidden or translucent belt\")\n            var ribs: [SCNNode] = []\n            for shoe in belt.shoes {\n                try Self.check(shoe.parent === belt.node && shoe.childNodes.count == 1,\n                               \"Unexpected shoe hierarchy\")\n                let rib = shoe.childNodes[0]\n                try Self.check(rib.childNodes.isEmpty, \"Unexpected rib hierarchy\")\n                for node in [shoe, rib] {\n                    try Self.check(seen.insert(ObjectIdentifier(node)).inserted,\n                                   \"A source node was selected twice\")\n                    try Self.check(!node.isHidden && node.opacity == 1 && node.skinner == nil && node.morpher == nil,\n                                   \"Hidden, translucent, skinned or morphed source\")\n                    try Self.check(Self.equal(Self.matrix(node.pivot), matrix_identity_float4x4) && node.animationKeys.isEmpty,\n                                   \"Nonidentity pivot or animated source\")\n                    try Self.check(node.constraints?.isEmpty ?? true, \"Constrained source\")\n                    guard let source = node.geometry else { throw Failure(\"Missing source geometry\") }\n                    try Self.validateGeometry(source)\n                    originals.append(Original(node: node, geometry: source,\n                                              copy: try Self.clone(source),\n                                              transform: node.simdTransform, hidden: node.isHidden))\n                }\n                ribs.append(rib)\n            }\n            // Keep the carcass and all nonselected nodes untouched.\n            pending.append(try build(nodes: belt.shoes, parent: belt.node,\n                                     name: \"Frozen belt \\(beltIndex) shoes\"))\n            pending.append(try build(nodes: ribs, parent: belt.node,\n                                     name: \"Frozen belt \\(beltIndex) ribs\"))\n        }\n        // Do not mutate the scene until all four batches have passed preflight.\n        batches = pending\n        for item in batches { item.parent.addChildNode(item.node) }\n    }\n\n    deinit {\n        restore()\n        for item in batches { item.node.removeFromParentNode() }\n    }\n\n    func setEnabled(_ value: Bool) throws { try setMode(value ? .batch : .original) }\n\n    func setMode(_ value: Mode) throws {\n        if value != .original {\n            for item in originals {\n                try Self.check(Self.equal(item.node.simdTransform, item.transform),\n                               \"Track moved after frozen capture; rebuild the probe\")\n                try Self.check(item.node.geometry === item.geometry || item.node.geometry === item.copy,\n                               \"Source geometry changed after capture\")\n            }\n        }\n        restore()\n        if value == .copyControl {\n            for item in originals { item.node.geometry = item.copy }\n        } else if value == .batch {\n            for item in originals { item.node.isHidden = true }\n            for item in batches { item.node.isHidden = false }\n        }\n        mode = value\n    }\n\n    private func restore() {\n        for item in originals {\n            item.node.geometry = item.geometry\n            item.node.isHidden = item.hidden\n        }\n        for item in batches { item.node.isHidden = true }\n        mode = .original\n    }\n\n    var statistics: [String: Any] {\n        [\"method\": \"Frozen native shoe/rib geometry batching; every original vertex and triangle retained. Initial dirtToBody reference encoded per vertex; current world contact retains the original surface expression.\",\n         \"mode\": mode.rawValue, \"originalGeometryNodes\": originals.count,\n         \"batchGeometryNodes\": batches.count, \"batches\": batches.map(\\.row),\n         \"copyControl\": \"Original nodes, unchanged source/index objects, materials and geometry-owned modifier/uniforms; new SCNGeometry wrappers only.\",\n         \"frozenPoseOnly\": true, \"dynamicAnimationValidated\": false,\n         \"performanceOrAppearanceAccepted\": false,\n         \"limitations\": [\"CPU Float baking and rest-coordinate interpolation may change rounding versus SceneKit transforms/inverse reconstruction.\",\n                         \"Reported numeric errors are against Double evaluation of the captured Float matrices, not native shader-output or image errors.\",\n                         \"Merged material draws change cross-node ordering and culling granularity. Inspect color, AO, both shadows, dirt and dune contact.\",\n                         \"The new rest-coordinate varying uses an added color stream, reset to white in the geometry modifier; verify generated shader behavior.\"]]\n    }\n\n    private func build(nodes: [SCNNode], parent: SCNNode, name: String) throws -> Built {\n        guard let firstNode = nodes.first, let first = firstNode.geometry,\n              let material = first.materials.first,\n              let surface = first.shaderModifiers?[.surface] else { throw Failure(\"Empty batch\") }\n        let layout = first.sources\n        var output = layout.map { _ in Data() }\n        var rest = Data(), indices: [UInt32] = []\n        var vertexCount = 0, primitiveCount = 0, inputElements = 0\n        var positionError = 0.0, normalError = 0.0, tangentError = 0.0, restError = 0.0\n        var rows: [[String: Any]] = []\n        for (ordinal, node) in nodes.enumerated() {\n            guard let source = node.geometry,\n                  let cachedRest = source.value(forKey: \"dirtToBody\") as? NSValue else {\n                throw Failure(\"Missing dirtToBody transform\")\n            }\n            try Self.validateGeometry(source)\n            try Self.check(source.sources.count == layout.count, \"Source layout count differs\")\n            for (a, b) in zip(source.sources, layout) {\n                try Self.check(a.semantic == b.semantic && a.componentsPerVector == b.componentsPerVector &&\n                               a.bytesPerComponent == b.bytesPerComponent && a.usesFloatComponents == b.usesFloatComponents,\n                               \"Source layout differs\")\n            }\n            try Self.check(source.shaderModifiers?[.surface] == surface, \"Coating shader differs\")\n            try Self.check(node.castsShadow == firstNode.castsShadow &&\n                           node.categoryBitMask == firstNode.categoryBitMask &&\n                           node.renderingOrder == firstNode.renderingOrder,\n                           \"Node render state differs\")\n            for m in source.materials { try Self.sameMaterial(m, material) }\n            for key in Self.uniformKeys where key != \"dirtToBody\" {\n                try Self.check(Self.sameValue(source.value(forKey: key), first.value(forKey: key)),\n                               \"Coating uniform differs: \\(key)\")\n    private func build(nodes: [SCNNode], parent: SCNNode, name: String) throws -> Built {\n        guard let firstNode = nodes.first, let first = firstNode.geometry,\n              let material = first.materials.first,\n              let surface = first.shaderModifiers?[.surface] else { throw Failure(\"Empty batch\") }\n        let layout = first.sources\n        var output = layout.map { _ in Data() }\n        var rest = Data(), indices: [UInt32] = []\n        var vertexCount = 0, primitiveCount = 0, inputElements = 0\n        var positionError = 0.0, normalError = 0.0, tangentError = 0.0, restError = 0.0\n        var rows: [[String: Any]] = []\n        for (ordinal, node) in nodes.enumerated() {\n            guard let source = node.geometry,\n                  let cachedRest = source.value(forKey: \"dirtToBody\") as? NSValue else {\n                throw Failure(\"Missing dirtToBody transform\")\n            }\n            try Self.validateGeometry(source)\n            try Self.check(source.sources.count == layout.count, \"Source layout count differs\")\n            for (a, b) in zip(source.sources, layout) {\n                try Self.check(a.semantic == b.semantic && a.componentsPerVector == b.componentsPerVector &&\n                               a.bytesPerComponent == b.bytesPerComponent && a.usesFloatComponents == b.usesFloatComponents,\n                               \"Source layout differs\")\n            }\n            try Self.check(source.shaderModifiers?[.surface] == surface, \"Coating shader differs\")\n            try Self.check(node.castsShadow == firstNode.castsShadow &&\n                           node.categoryBitMask == firstNode.categoryBitMask &&\n                           node.renderingOrder == firstNode.renderingOrder,\n                           \"Node render state differs\")\n            for m in source.materials { try Self.sameMaterial(m, material) }\n            for key in Self.uniformKeys where key != \"dirtToBody\" {\n                try Self.check(Self.sameValue(source.value(forKey: key), first.value(forKey: key)),\n                               \"Coating uniform differs: \\(key)\")\n            }\n            let current = Self.matrix(node.convertTransform(SCNMatrix4Identity, to: parent))\n            let reference = Self.matrix(cachedRest.scnMatrix4Value)\n            try Self.checkRigid(current)\n            try Self.checkRigid(reference)\n            let linear = simd_float3x3(columns: (SIMD3(current[0].x,current[0].y,current[0].z),\n                                                SIMD3(current[1].x,current[1].y,current[1].z),\n                                                SIMD3(current[2].x,current[2].y,current[2].z)))\n            let inverseTranspose = simd_transpose(simd_inverse(linear))\n            let normalMatrix = simd_float4x4(columns: (\n                SIMD4(inverseTranspose[0].x,inverseTranspose[0].y,inverseTranspose[0].z,0),\n                SIMD4(inverseTranspose[1].x,inverseTranspose[1].y,inverseTranspose[1].z,0),\n                SIMD4(inverseTranspose[2].x,inverseTranspose[2].y,inverseTranspose[2].z,0),\n                SIMD4<Float>(0,0,0,1)))\n            let positionSource = source.sources(for: .vertex)[0]\n            let count = positionSource.vectorCount\n            let base = UInt32(vertexCount)\n            for vertex in 0..<count {\n                let p = try Self.read3(positionSource, vertex)\n                let q = reference * SIMD4<Float>(p.x, p.y, p.z, 1)\n                restError = max(restError, Self.error(q, Self.precise(reference, SIMD4<Float>(p.x, p.y, p.z, 1))))\n                Self.append([q.x, q.y, q.z, 1], to: &rest)\n                for (slot, attribute) in source.sources.enumerated() {\n                    if attribute.semantic == .vertex {\n                        let moved = current * SIMD4<Float>(p.x, p.y, p.z, 1)\n                        positionError = max(positionError, Self.error(moved, Self.precise(current, SIMD4<Float>(p.x, p.y, p.z, 1))))\n                        Self.append([moved.x, moved.y, moved.z], to: &output[slot])\n                    } else if attribute.semantic == .normal || attribute.semantic == .tangent {\n                        let n = try Self.read3(attribute, vertex)\n                        let transform = attribute.semantic == .normal ? normalMatrix : current\n                        let moved = transform * SIMD4<Float>(n.x, n.y, n.z, 0)\n                        let error = Self.error(moved, Self.precise(transform, SIMD4<Float>(n.x, n.y, n.z, 0)))\n                        if attribute.semantic == .normal { normalError = max(normalError, error) }\n                        else { tangentError = max(tangentError, error) }\n                        Self.append([moved.x, moved.y, moved.z], to: &output[slot])\n                        if attribute.componentsPerVector == 4 {\n                            let offset = attribute.dataOffset + vertex * attribute.dataStride + 12\n                            output[slot].append(attribute.data.subdata(in: offset..<(offset + 4)))\n                        }\n                    } else {\n                        let offset = attribute.dataOffset + vertex * attribute.dataStride\n                        output[slot].append(attribute.data.subdata(in: offset..<(offset + attribute.componentsPerVector * 4)))\n                    }\n                }\n            }\n            var nodeTriangles = 0\n            for element in source.elements {\n                try Self.check(element.primitiveType == .triangles && [1, 2, 4].contains(element.bytesPerIndex),\n                               \"Nontriangle or unsupported indices\")\n                try Self.check(element.primitiveRange.location == NSNotFound ||\n                               (element.primitiveRange.location == 0 && element.primitiveRange.length == element.primitiveCount),\n                               \"Partial primitive range is unsupported\")\n                let bytes = element.data\n                try Self.check(bytes.count >= element.primitiveCount * 3 * element.bytesPerIndex,\n                               \"Truncated index data\")\n                for index in 0..<(element.primitiveCount * 3) {\n                    let old = bytes.withUnsafeBytes { raw -> UInt32 in\n                        let offset = index * element.bytesPerIndex\n                        if element.bytesPerIndex == 1 { return UInt32(raw.loadUnaligned(fromByteOffset: offset, as: UInt8.self)) }\n                        if element.bytesPerIndex == 2 { return UInt32(raw.loadUnaligned(fromByteOffset: offset, as: UInt16.self)) }\n                        return raw.loadUnaligned(fromByteOffset: offset, as: UInt32.self)\n                    }\n                    try Self.check(old < UInt32(count), \"Index is out of bounds\")\n                    indices.append(base + old)\n                }\n                nodeTriangles += element.primitiveCount\n            }\n            primitiveCount += nodeTriangles\n            inputElements += source.elements.count\n            vertexCount += count\n            rows.append([\"ordinal\": ordinal, \"vertices\": count, \"triangles\": nodeTriangles,\n                         \"currentToBelt\": Self.values(current), \"initialToBody\": Self.values(reference)])\n        }\n        var sources = zip(layout, output).map { source, data in\n            SCNGeometrySource(data: data, semantic: source.semantic, vectorCount: vertexCount,\n                              usesFloatComponents: true, componentsPerVector: source.componentsPerVector,\n                              bytesPerComponent: 4, dataOffset: 0, dataStride: source.componentsPerVector * 4)\n        }\n        sources.append(SCNGeometrySource(data: rest, semantic: .color, vectorCount: vertexCount,\n                                         usesFloatComponents: true, componentsPerVector: 4,\n                                         bytesPerComponent: 4, dataOffset: 0, dataStride: 16))\n        let element = SCNGeometryElement(indices: indices, primitiveType: .triangles)\n        let geometry = SCNGeometry(sources: sources, elements: [element])\n        geometry.materials = [material]\n        geometry.shaderModifiers = [.geometry: Self.geometryModifier,\n            .surface: surface.replacingOccurrences(of: Self.referenceLine,\n                       with: \"float3 p = in.trackFrozenRestBody / dirtHeight;\")]\n        for key in Self.uniformKeys { geometry.setValue(first.value(forKey: key), forKey: key) }\n        let batch = SCNNode(geometry: geometry)\n        batch.name = name; batch.isHidden = true\n        batch.castsShadow = firstNode.castsShadow\n        batch.categoryBitMask = firstNode.categoryBitMask\n        batch.renderingOrder = firstNode.renderingOrder\n        return Built(parent: parent, node: batch, row: [\n            \"name\": name, \"inputNodes\": nodes.count, \"inputElements\": inputElements,\n            \"outputNodes\": 1, \"outputElements\": 1, \"vertices\": vertexCount,\n            \"triangles\": primitiveCount, \"triangleCountPreserved\": indices.count == primitiveCount * 3,\n            \"allOriginalVerticesRetained\": true, \"indicesOnlyRebasedInOriginalNodeElementTriangleOrder\": true,\n            \"untouchedAttributeBytesCopied\": true,\n            \"maxPositionComponentErrorVsDouble\": positionError,\n            \"maxNormalComponentErrorVsDouble\": normalError,\n            \"maxTangentComponentErrorVsDouble\": tangentError,\n            \"maxRestBodyComponentErrorVsDouble\": restError,\n            \"poses\": rows])\n    }\n\n    private static func validateGeometry(_ geometry: SCNGeometry) throws {\n        try check(geometry.program == nil && geometry.tessellator == nil && geometry.subdivisionLevel == 0 &&\n                  (geometry.levelsOfDetail?.isEmpty ?? true), \"Program, tessellation, subdivision or LOD is unsupported\")\n        guard let modifiers = geometry.shaderModifiers, modifiers.count == 1,\n"},"started_at_ms":1791037326444,"completed_at_ms":1791037326445}}
{"timestamp":"2026-10-03T14:22:06.448Z","ordinal":18647,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10224-c470-7362-9f40-7444a0b603e1","call_id":"call_cqdVvAQGS1Ppt26V3UMQ6gJJ","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"cf038c\",\"wall_time_seconds\":0.000003292,\"exit_code\":0,\"original_token_count\":4633,\"output\":\"import AppKit\\nimport SceneKit\\nimport simd\\n\\n/// FROZEN-POSE DIAGNOSTIC ONLY. No animation/update path and no game default.\\n/// Build after DirtCoating.install and after the native renderer has settled.\\n/// Keep simulation stopped while this object exists. Camera/root motion is OK;\\n/// shoe/rib local transforms and geometry must remain the captured pose.\\nfinal class TrackBatchProbe {\\n    enum Mode: String { case original, copyControl, batch }\\n    struct Failure: Error, CustomStringConvertible {\\n        let description: String\\n        init(_ description: String) { self.description = description }\\n    }\\n    private struct Original {\\n        let node: SCNNode\\n        let geometry: SCNGeometry\\n        let copy: SCNGeometry\\n        let transform: simd_float4x4\\n        let hidden: Bool\\n    }\\n    private struct Built {\\n        let parent: SCNNode\\n        let node: SCNNode\\n        let row: [String: Any]\\n    }\\n    private var originals: [Original] = []\\n    private var batches: [Built] = []\\n    private(set) var mode: Mode = .original\\n    private static let uniformKeys = [\\\"dirtToBody\\\", \\\"dirtHeight\\\", \\\"dirtWheelX\\\", \\\"duneContact\\\", \\\"dirtRolling\\\"]\\n    private static let referenceLine = \\\"float3 p = (dirtToBody * float4(local,1.0)).xyz / dirtHeight;\\\"\\n    private static let geometryModifier = \\\"\\\"\\\"\\n    #pragma varyings\\n    float3 trackFrozenRestBody;\\n    #pragma body\\n    out.trackFrozenRestBody = _geometry.color.xyz;\\n    _geometry.color = float4(1.0);\\n    \\\"\\\"\\\"\\n\\n    init(root: SCNNode, tracks: [TrackBelt]) throws {\\n        try Self.check(tracks.count == 2, \\\"Expected two native TrackBelt instances\\\")\\n        var seen = Set<ObjectIdentifier>()\\n        var pending: [Built] = []\\n        for (beltIndex, belt) in tracks.enumerated() {\\n            try Self.check(belt.node.parent === root && belt.shoes.count == 56,\\n                           \\\"Unexpected belt parent or shoe count\\\")\\n            try Self.check(!belt.node.isHidden && belt.node.opacity == 1,\\n                           \\\"Hidden or translucent belt\\\")\\n            var ribs: [SCNNode] = []\\n            for shoe in belt.shoes {\\n                try Self.check(shoe.parent === belt.node && shoe.childNodes.count == 1,\\n                               \\\"Unexpected shoe hierarchy\\\")\\n                let rib = shoe.childNodes[0]\\n                try Self.check(rib.childNodes.isEmpty, \\\"Unexpected rib hierarchy\\\")\\n                for node in [shoe, rib] {\\n                    try Self.check(seen.insert(ObjectIdentifier(node)).inserted,\\n                                   \\\"A source node was selected twice\\\")\\n                    try Self.check(!node.isHidden && node.opacity == 1 && node.skinner == nil && node.morpher == nil,\\n                                   \\\"Hidden, translucent, skinned or morphed source\\\")\\n                    try Self.check(Self.equal(Self.matrix(node.pivot), matrix_identity_float4x4) && node.animationKeys.isEmpty,\\n                                   \\\"Nonidentity pivot or animated source\\\")\\n                    try Self.check(node.constraints?.isEmpty ?? true, \\\"Constrained source\\\")\\n                    guard let source = node.geometry else { throw Failure(\\\"Missing source geometry\\\") }\\n                    try Self.validateGeometry(source)\\n                    originals.append(Original(node: node, geometry: source,\\n                                              copy: try Self.clone(source),\\n                                              transform: node.simdTransform, hidden: node.isHidden))\\n                }\\n                ribs.append(rib)\\n            }\\n            // Keep the carcass and all nonselected nodes untouched.\\n            pending.append(try build(nodes: belt.shoes, parent: belt.node,\\n                                     name: \\\"Frozen belt \\\\(beltIndex) shoes\\\"))\\n            pending.append(try build(nodes: ribs, parent: belt.node,\\n                                     name: \\\"Frozen belt \\\\(beltIndex) ribs\\\"))\\n        }\\n        // Do not mutate the scene until all four batches have passed preflight.\\n        batches = pending\\n        for item in batches { item.parent.addChildNode(item.node) }\\n    }\\n\\n    deinit {\\n        restore()\\n        for item in batches { item.node.removeFromParentNode() }\\n    }\\n\\n    func setEnabled(_ value: Bool) throws { try setMode(value ? .batch : .original) }\\n\\n    func setMode(_ value: Mode) throws {\\n        if value != .original {\\n            for item in originals {\\n                try Self.check(Self.equal(item.node.simdTransform, item.transform),\\n                               \\\"Track moved after frozen capture; rebuild the probe\\\")\\n                try Self.check(item.node.geometry === item.geometry || item.node.geometry === item.copy,\\n                               \\\"Source geometry changed after capture\\\")\\n            }\\n        }\\n        restore()\\n        if value == .copyControl {\\n            for item in originals { item.node.geometry = item.copy }\\n        } else if value == .batch {\\n            for item in originals { item.node.isHidden = true }\\n            for item in batches { item.node.isHidden = false }\\n        }\\n        mode = value\\n    }\\n\\n    private func restore() {\\n        for item in originals {\\n            item.node.geometry = item.geometry\\n            item.node.isHidden = item.hidden\\n        }\\n        for item in batches { item.node.isHidden = true }\\n        mode = .original\\n    }\\n\\n    var statistics: [String: Any] {\\n        [\\\"method\\\": \\\"Frozen native shoe/rib geometry batching; every original vertex and triangle retained. Initial dirtToBody reference encoded per vertex; current world contact retains the original surface expression.\\\",\\n         \\\"mode\\\": mode.rawValue, \\\"originalGeometryNodes\\\": originals.count,\\n         \\\"batchGeometryNodes\\\": batches.count, \\\"batches\\\": batches.map(\\\\.row),\\n         \\\"copyControl\\\": \\\"Original nodes, unchanged source/index objects, materials and geometry-owned modifier/uniforms; new SCNGeometry wrappers only.\\\",\\n         \\\"frozenPoseOnly\\\": true, \\\"dynamicAnimationValidated\\\": false,\\n         \\\"performanceOrAppearanceAccepted\\\": false,\\n         \\\"limitations\\\": [\\\"CPU Float baking and rest-coordinate interpolation may change rounding versus SceneKit transforms/inverse reconstruction.\\\",\\n                         \\\"Reported numeric errors are against Double evaluation of the captured Float matrices, not native shader-output or image errors.\\\",\\n                         \\\"Merged material draws change cross-node ordering and culling granularity. Inspect color, AO, both shadows, dirt and dune contact.\\\",\\n                         \\\"The new rest-coordinate varying uses an added color stream, reset to white in the geometry modifier; verify generated shader behavior.\\\"]]\\n    }\\n\\n    private func build(nodes: [SCNNode], parent: SCNNode, name: String) throws -> Built {\\n        guard let firstNode = nodes.first, let first = firstNode.geometry,\\n              let material = first.materials.first,\\n              let surface = first.shaderModifiers?[.surface] else { throw Failure(\\\"Empty batch\\\") }\\n        let layout = first.sources\\n        var output = layout.map { _ in Data() }\\n        var rest = Data(), indices: [UInt32] = []\\n        var vertexCount = 0, primitiveCount = 0, inputElements = 0\\n        var positionError = 0.0, normalError = 0.0, tangentError = 0.0, restError = 0.0\\n        var rows: [[String: Any]] = []\\n        for (ordinal, node) in nodes.enumerated() {\\n            guard let source = node.geometry,\\n                  let cachedRest = source.value(forKey: \\\"dirtToBody\\\") as? NSValue else {\\n                throw Failure(\\\"Missing dirtToBody transform\\\")\\n            }\\n            try Self.validateGeometry(source)\\n            try Self.check(source.sources.count == layout.count, \\\"Source layout count differs\\\")\\n            for (a, b) in zip(source.sources, layout) {\\n                try Self.check(a.semantic == b.semantic && a.componentsPerVector == b.componentsPerVector &&\\n                               a.bytesPerComponent == b.bytesPerComponent && a.usesFloatComponents == b.usesFloatComponents,\\n                               \\\"Source layout differs\\\")\\n            }\\n            try Self.check(source.shaderModifiers?[.surface] == surface, \\\"Coating shader differs\\\")\\n            try Self.check(node.castsShadow == firstNode.castsShadow &&\\n                           node.categoryBitMask == firstNode.categoryBitMask &&\\n                           node.renderingOrder == firstNode.renderingOrder,\\n                           \\\"Node render state differs\\\")\\n            for m in source.materials { try Self.sameMaterial(m, material) }\\n            for key in Self.uniformKeys where key != \\\"dirtToBody\\\" {\\n                try Self.check(Self.sameValue(source.value(forKey: key), first.value(forKey: key)),\\n                               \\\"Coating uniform differs: \\\\(key)\\\")\\n    private func build(nodes: [SCNNode], parent: SCNNode, name: String) throws -> Built {\\n        guard let firstNode = nodes.first, let first = firstNode.geometry,\\n              let material = first.materials.first,\\n              let surface = first.shaderModifiers?[.surface] else { throw Failure(\\\"Empty batch\\\") }\\n        let layout = first.sources\\n        var output = layout.map { _ in Data() }\\n        var rest = Data(), indices: [UInt32] = []\\n        var vertexCount = 0, primitiveCount = 0, inputElements = 0\\n        var positionError = 0.0, normalError = 0.0, tangentError = 0.0, restError = 0.0\\n        var rows: [[String: Any]] = []\\n        for (ordinal, node) in nodes.enumerated() {\\n            guard let source = node.geometry,\\n                  let cachedRest = source.value(forKey: \\\"dirtToBody\\\") as? NSValue else {\\n                throw Failure(\\\"Missing dirtToBody transform\\\")\\n            }\\n            try Self.validateGeometry(source)\\n            try Self.check(source.sources.count == layout.count, \\\"Source layout count differs\\\")\\n            for (a, b) in zip(source.sources, layout) {\\n                try Self.check(a.semantic == b.semantic && a.componentsPerVector == b.componentsPerVector &&\\n                               a.bytesPerComponent == b.bytesPerComponent && a.usesFloatComponents == b.usesFloatComponents,\\n                               \\\"Source layout differs\\\")\\n            }\\n            try Self.check(source.shaderModifiers?[.surface] == surface, \\\"Coating shader differs\\\")\\n            try Self.check(node.castsShadow == firstNode.castsShadow &&\\n                           node.categoryBitMask == firstNode.categoryBitMask &&\\n                           node.renderingOrder == firstNode.renderingOrder,\\n                           \\\"Node render state differs\\\")\\n            for m in source.materials { try Self.sameMaterial(m, material) }\\n            for key in Self.uniformKeys where key != \\\"dirtToBody\\\" {\\n                try Self.check(Self.sameValue(source.value(forKey: key), first.value(forKey: key)),\\n                               \\\"Coating uniform differs: \\\\(key)\\\")\\n            }\\n            let current = Self.matrix(node.convertTransform(SCNMatrix4Identity, to: parent))\\n            let reference = Self.matrix(cachedRest.scnMatrix4Value)\\n            try Self.checkRigid(current)\\n            try Self.checkRigid(reference)\\n            let linear = simd_float3x3(columns: (SIMD3(current[0].x,current[0].y,current[0].z),\\n                                                SIMD3(current[1].x,current[1].y,current[1].z),\\n                                                SIMD3(current[2].x,current[2].y,current[2].z)))\\n            let inverseTranspose = simd_transpose(simd_inverse(linear))\\n            let normalMatrix = simd_float4x4(columns: (\\n                SIMD4(inverseTranspose[0].x,inverseTranspose[0].y,inverseTranspose[0].z,0),\\n                SIMD4(inverseTranspose[1].x,inverseTranspose[1].y,inverseTranspose[1].z,0),\\n                SIMD4(inverseTranspose[2].x,inverseTranspose[2].y,inverseTranspose[2].z,0),\\n                SIMD4<Float>(0,0,0,1)))\\n            let positionSource = source.sources(for: .vertex)[0]\\n            let count = positionSource.vectorCount\\n            let base = UInt32(vertexCount)\\n            for vertex in 0..<count {\\n                let p = try Self.read3(positionSource, vertex)\\n                let q = reference * SIMD4<Float>(p.x, p.y, p.z, 1)\\n                restError = max(restError, Self.error(q, Self.precise(reference, SIMD4<Float>(p.x, p.y, p.z, 1))))\\n                Self.append([q.x, q.y, q.z, 1], to: &rest)\\n                for (slot, attribute) in source.sources.enumerated() {\\n                    if attribute.semantic == .vertex {\\n                        let moved = current * SIMD4<Float>(p.x, p.y, p.z, 1)\\n                        positionError = max(positionError, Self.error(moved, Self.precise(current, SIMD4<Float>(p.x, p.y, p.z, 1))))\\n                        Self.append([moved.x, moved.y, moved.z], to: &output[slot])\\n                    } else if attribute.semantic == .normal || attribute.semantic == .tangent {\\n                        let n = try Self.read3(attribute, vertex)\\n                        let transform = attribute.semantic == .normal ? normalMatrix : current\\n                        let moved = transform * SIMD4<Float>(n.x, n.y, n.z, 0)\\n                        let error = Self.error(moved, Self.precise(transform, SIMD4<Float>(n.x, n.y, n.z, 0)))\\n                        if attribute.semantic == .normal { normalError = max(normalError, error) }\\n                        else { tangentError = max(tangentError, error) }\\n                        Self.append([moved.x, moved.y, moved.z], to: &output[slot])\\n                        if attribute.componentsPerVector == 4 {\\n                            let offset = attribute.dataOffset + vertex * attribute.dataStride + 12\\n                            output[slot].append(attribute.data.subdata(in: offset..<(offset + 4)))\\n                        }\\n                    } else {\\n                        let offset = attribute.dataOffset + vertex * attribute.dataStride\\n                        output[slot].append(attribute.data.subdata(in: offset..<(offset + attribute.componentsPerVector * 4)))\\n                    }\\n                }\\n            }\\n            var nodeTriangles = 0\\n            for element in source.elements {\\n                try Self.check(element.primitiveType == .triangles && [1, 2, 4].contains(element.bytesPerIndex),\\n                               \\\"Nontriangle or unsupported indices\\\")\\n                try Self.check(element.primitiveRange.location == NSNotFound ||\\n                               (element.primitiveRange.location == 0 && element.primitiveRange.length == element.primitiveCount),\\n                               \\\"Partial primitive range is unsupported\\\")\\n                let bytes = element.data\\n                try Self.check(bytes.count >= element.primitiveCount * 3 * element.bytesPerIndex,\\n                               \\\"Truncated index data\\\")\\n                for index in 0..<(element.primitiveCount * 3) {\\n                    let old = bytes.withUnsafeBytes { raw -> UInt32 in\\n                        let offset = index * element.bytesPerIndex\\n                        if element.bytesPerIndex == 1 { return UInt32(raw.loadUnaligned(fromByteOffset: offset, as: UInt8.self)) }\\n                        if element.bytesPerIndex == 2 { return UInt32(raw.loadUnaligned(fromByteOffset: offset, as: UInt16.self)) }\\n                        return raw.loadUnaligned(fromByteOffset: offset, as: UInt32.self)\\n                    }\\n                    try Self.check(old < UInt32(count), \\\"Index is out of bounds\\\")\\n                    indices.append(base + old)\\n                }\\n                nodeTriangles += element.primitiveCount\\n            }\\n            primitiveCount += nodeTriangles\\n            inputElements += source.elements.count\\n            vertexCount += count\\n            rows.append([\\\"ordinal\\\": ordinal, \\\"vertices\\\": count, \\\"triangles\\\": nodeTriangles,\\n                         \\\"currentToBelt\\\": Self.values(current), \\\"initialToBody\\\": Self.values(reference)])\\n        }\\n        var sources = zip(layout, output).map { source, data in\\n            SCNGeometrySource(data: data, semantic: source.semantic, vectorCount: vertexCount,\\n                              usesFloatComponents: true, componentsPerVector: source.componentsPerVector,\\n                              bytesPerComponent: 4, dataOffset: 0, dataStride: source.componentsPerVector * 4)\\n        }\\n        sources.append(SCNGeometrySource(data: rest, semantic: .color, vectorCount: vertexCount,\\n                                         usesFloatComponents: true, componentsPerVector: 4,\\n                                         bytesPerComponent: 4, dataOffset: 0, dataStride: 16))\\n        let element = SCNGeometryElement(indices: indices, primitiveType: .triangles)\\n        let geometry = SCNGeometry(sources: sources, elements: [element])\\n        geometry.materials = [material]\\n        geometry.shaderModifiers = [.geometry: Self.geometryModifier,\\n            .surface: surface.replacingOccurrences(of: Self.referenceLine,\\n                       with: \\\"float3 p = in.trackFrozenRestBody / dirtHeight;\\\")]\\n        for key in Self.uniformKeys { geometry.setValue(first.value(forKey: key), forKey: key) }\\n        let batch = SCNNode(geometry: geometry)\\n        batch.name = name; batch.isHidden = true\\n        batch.castsShadow = firstNode.castsShadow\\n        batch.categoryBitMask = firstNode.categoryBitMask\\n        batch.renderingOrder = firstNode.renderingOrder\\n        return Built(parent: parent, node: batch, row: [\\n            \\\"name\\\": name, \\\"inputNodes\\\": nodes.count, \\\"inputElements\\\": inputElements,\\n            \\\"outputNodes\\\": 1, \\\"outputElements\\\": 1, \\\"vertices\\\": vertexCount,\\n            \\\"triangles\\\": primitiveCount, \\\"triangleCountPreserved\\\": indices.count == primitiveCount * 3,\\n            \\\"allOriginalVerticesRetained\\\": true, \\\"indicesOnlyRebasedInOriginalNodeElementTriangleOrder\\\": true,\\n            \\\"untouchedAttributeBytesCopied\\\": true,\\n            \\\"maxPositionComponentErrorVsDouble\\\": positionError,\\n            \\\"maxNormalComponentErrorVsDouble\\\": normalError,\\n            \\\"maxTangentComponentErrorVsDouble\\\": tangentError,\\n            \\\"maxRestBodyComponentErrorVsDouble\\\": restError,\\n            \\\"poses\\\": rows])\\n    }\\n\\n    private static func validateGeometry(_ geometry: SCNGeometry) throws {\\n        try check(geometry.program == nil && geometry.tessellator == nil && geometry.subdivisionLevel == 0 &&\\n                  (geometry.levelsOfDetail?.isEmpty ?? true), \\\"Program, tessellation, subdivision or LOD is unsupported\\\")\\n        guard let modifiers = geometry.shaderModifiers, modifiers.count == 1,\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10203-cbf2-7142-9114-67ec5e108a8c","create_time":1791037326.448323}}}
