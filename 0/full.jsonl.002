{"timestamp":"2026-10-03T14:22:54.246Z","ordinal":18659,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":194863786,"cached_input_tokens":192201728,"cache_write_input_tokens":0,"output_tokens":475752,"reasoning_output_tokens":186099,"total_tokens":195339538},"last_token_usage":{"input_tokens":77567,"cached_input_tokens":72960,"cache_write_input_tokens":0,"output_tokens":441,"reasoning_output_tokens":164,"total_tokens":78008},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":37.0,"window_minutes":10080,"resets_at":1791583130},"secondary":null,"credits":{"has_credits":true,"unlimited":false,"balance":"63618.8998305000"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
