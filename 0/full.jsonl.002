amera:SCNCamera\n    private let cameraMask:Int\n    private let lights:[(SCNLight,Int)]\n    private var enabled=false\n    private(set) var inputVertices=0,outputVertices=0,inputElements=0,outputElements=0\n    private(set) var triangles=0\n    private var cache:[ObjectIdentifier:SCNGeometry]=[:]\n    private static let proxyBit=1 << 20\n    private let single=SCNMaterial(),double=SCNMaterial()\n    enum Failure:Error { case unsupportedGeometry }\n\n    init(root:SCNNode,camera:SCNCamera)throws {\n        self.camera=camera;cameraMask=camera.categoryBitMask\n        var lights:[(SCNLight,Int)]=[],nodes:[SCNNode]=[]\n        root.enumerateChildNodes { node,_ in\nAxis_Mount [(2, 9, {'changedPixels': 234, 'maximumChannelDelta': 19}), (2, 7, {'changedPixels': 224, 'maximumChannelDelta': 27})]\nBattery [(2, 1, {'changedPixels': 275, 'maximumChannelDelta': 9}), (2, 7, {'changedPixels': 226, 'maximumChannelDelta': 27})]\nBearings [(1, 5, {'changedPixels': 196, 'maximumChannelDelta': 33}), (1, 8, {'changedPixels': 188, 'maximumChannelDelta': 11})]\nMotor_Left [(1, 5, {'changedPixels': 304, 'maximumChannelDelta': 48}), (0, 5, {'changedPixels': 254, 'maximumChannelDelta': 30})]\nMotor_Right [(1, 5, {'changedPixels': 304, 'maximumChannelDelta': 48}), (0, 5, {'changedPixels': 254, 'maximumChannelDelta': 30})]\nServo_Head [(1, 5, {'changedPixels': 255, 'maximumChannelDelta': 33}), (0, 7, {'changedPixels': 239, 'maximumChannelDelta': 24})]\nServo_Tilt [(2, 5, {'changedPixels': 1773, 'maximumChannelDelta': 51}), (2, 7, {'changedPixels': 1559, 'maximumChannelDelta': 27})]\n","stderr":"","aggregated_output":"import SceneKit\nimport simd\n\n/// Shadow geometry: identical static town triangles, welded only by\n/// exact position, with separate single/double-sided material groups. The main\n/// camera keeps its original geometry, materials, tangents and LODs.\nfinal class TownShadowBatch {\n    private struct Pair {\n        let original:SCNNode,proxy:SCNNode\n        var castsShadow