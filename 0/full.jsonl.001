ptimizedCasters\\\": 8,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 34,\\n      \\\"view\\\": \\\"storm-uncovered-infield\\\"\\n    },\\n    {\\n      \\\"changedFraction\\\": 0,\\n      \\\"comparedPixels\\\": 2073600,\\n      \\\"maximumChannelError\\\": 0,\\n      \\\"meanMaxChannelError\\\": 0,\\n      \\\"optimizedCasters\\\": 14,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 41,\\n      \\\"view\\\": \\\"storm-inner-fade\\\"\\n    },\\n    {\\n      \\\"changedFraction\\\": 0,\\n      \\\"comparedPixels\\\": 2073600,\\n      \\\"maximumChannelError\\\": 0,\\n      \\\"meanMaxChannelError\\\": 0,\\n      \\\"optimizedCasters\\\": 17,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 26,\\n      \\\"view\\\": \\\"storm-grazing\\\"\\n    },\\n    {\\n      \\\"changedFraction\\\": 0,\\n      \\\"comparedPixels\\\": 2073600,\\n      \\\"maximumChannelError\\\": 0,\\n      \\\"meanMaxChannelError\\\": 0,\\n      \\\"optimizedCasters\\\": 23,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 45,\\n      \\\"view\\\": \\\"storm-reverse-turn\\\"\\n    },\\n    {\\n      \\\"changedFraction\\\": 0,\\n      \\\"comparedPixels\\\": 2073600,\\n      \\\"maximumChannelError\\\": 0,\\n      \\\"meanMaxChannelError\\\": 0,\\n      \\\"optimizedCasters\\\": 18,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 18,\\n      \\\"view\\\": \\\"storm-lod-boundary\\\"\\n    },\\n    {\\n      \\\"changedFraction\\\": 0,\\n      \\\"comparedPixels\\\": 2073600,\\n      \\\"maximumChannelError\\\": 0,\\n      \\\"meanMaxChannelError\\\": 0,\\n      \\\"optimizedCasters\\\": 10,\\n      \\\"pixelEncoding\\\": \\\"packed 8-bit bitmap channels\\\",\\n      \\\"referenceCasters\\\": 40,\\n      \\\"view\\\": \\\"storm