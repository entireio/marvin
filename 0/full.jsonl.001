alue\\n        if original.castsShadow { original.castsShadow=false }\\n        let proxy=pairs[i].proxy\\n        if proxy.castsShadow != value { proxy.castsShadow=value }\\n        if proxy.isHidden == value { proxy.isHidden = !value }\\n        return true\\n    }\\n''' + s[a:]\\ns=s.replace('\\\"nodes\\\":pairs.count,','\\\"enabled\\\":enabled ? 1:0,\\\"activeProxies\\\":pairs.filter{!$0.proxy.isHidden \u0026\u0026 $0.proxy.castsShadow}.count,\\\"originalCasters\\\":pairs.filter{$0.original.castsShadow}.count,\\\"nodes\\\":pairs.count,')\\nopen(p,'w').write(s)\\np='apps/simulator-macos/Sources/MarvinSimulator/TownWorld.swift';s=open(p).read()\\ns=s.replace('    private var architectureNodes:[SCNNode]=[]','    private var architectureNodes:[SCNNode]=[]\\\\n    private var shadowBatch:TownShadowBatch?\\\\n    func prepareShadowBatch(camera:SCNCamera)throws {\\\\n        if shadowBatch==nil {\\\\n            guard let sceneRoot=root.parent else { throw TownShadowBatch.Failure.unsupportedGeometry }\\\\n            shadowBatch=try TownShadowBatch(root:sceneRoot,camera:camera)\\\\n        }\\\\n        shadowBatch?.setEnabled(true)\\\\n    }\\\\n    func setShadowBatchEnabled(_ enabled:Bool) { shadowBatch?.setEnabled(enabled) }\\\\n    var shadowBatchDiagnostics:[String:Int] { shadowBatch?.statistics ?? [:] }')\\ns=s.replace('            if node.castsShadow != enabled { node.castsShadow=enabled }','            if shadowBatch?.setCaster(node,enabled:enabled) != true, node.castsShadow != enabled { node.castsShadow=enabled }')\\nopen(p,'w').write(s)\\np='apps/simulator-macos/Sources/MarvinSimulator/App.swift';s=open(p).read();needle='        dirtWorld.sky.attach(camera:world.camera)'\\ns=s.replace(needle,needle+'\\\\n        if CommandLine.arguments.contains(\\\"--benchmark-shadow-batch-live\\\") {\\\\n            do { try dirtWorld.town.prepareShadowBatch(camera:world.camera.camera!) }\\\\n            catch { NSLog(\\\"Shadow batch preparation failed: %@\\\",String(describing:error));exit(1) }\\\\n        }')\\nopen(p,'w').write(s)\\np='apps/simulator-macos/Sources/MarvinSimulator/TownSmoke.swift';s=open(p).read().replace('\\\"trails\\\":dirtWorld.trailDiagnostics()]','\\\"trails\\\":dirtWorld.trailDiagnostics(),\\\"shadowBatch\\\":dirtWorld.town.shadowBatchDiagnostics]')\\ns=s.replace('            report[\\\"thermalState\\\"]=', '            report[\\\"shadowBatch\\\"]=dirtWorld.town.shadowBatchDiagnostics\\\\n            report[\\\"thermalState\\\"]=')\\nopen(p,'w').write(s)\\np='apps/simulator-macos/Sources/MarvinSimulator/GroundPerformanceSmoke.swift';s=open(p).read()\\ns=s.replace('            let shadowBatchComparison=CommandLine.arguments.contains(\\\"--benchmark-shadow-batch\\\")\\\\n            let shadowBatch=shadowBatchComparison ?', '            let liveShadowBatch=CommandLine.arguments.contains(\\\"--benchmark-shadow-batch-live\\\")\\\\n            let shadowBatchComparison=CommandLine.arguments.contains(\\\"--benchmark-shadow-batch\\\") || liveShadowBatch\\\\n            var shadowBatchSyncPassed=true\\\\n            let shadowBatch=shadowBatchComparison \u0026\u0026 !liveShadowBatch ?')\\ns=s.replace('                        shadowBatch?.setEnabled(false)','                        shadowBatch?.setEnabled(false)\\\\n                        if liveShadowBatch { dirtWorld.town.setShadowBatchEnabled(false) }')\\ns=s.replace('                        shadowBatch?.setEnabled(useOptimized)','''                        shadowBatch?.setEnabled(useOptimized)\\n                        if liveShadowBatch {\\n                            dirtWorld.town.setShadowBatchEnabled(useOptimized)\\n                            // Change the caster footprint while already enabled,\\n                            // then return. A frozen-only toggle would leave stale\\n                            // proxies or re-enable duplicate original casters.\\n                            for position in [SIMD2\u003cDouble\u003e(-140,-140),SIMD2(Double(target.x),Double(target.z))] {\\n                                dirtWorld.town.update(dt:0,camera:SCNVector3(position.x,eye.y,position.y),player:position,shadowCamera:world.camera,viewportAspect:1920.0/1080)\\n                                let state=dirtWorld.town.shadowBatchDiagnostics,expected=dirtWorld.town.shadowCasterCount\\n                                shadowBatchSyncPassed = shadowBatchSyncPassed \u0026\u0026 state[\\\"enabled\\\"]==(useOptimized ? 1:0)\\n                                    \u0026\u0026 state[\\\"activeProxies\\\"]==(useOptimized ? expected:0)\\n                                    \u0026\u0026 state[\\\"originalCasters\\\"]==(useOptimized ? 0:expected)\\n                            }\\n                            dirtWorld.town.update(dt:0,camera:eye,player:SIMD2(Double(target.x),Double(target.z)),shadowCamera:world.camera,viewportAspect:1920.0/1080)\\n                        }''')\\ns=s.replace('let passed=tangentFixturesPassed \u0026\u0026','let passed=shadowBatchSyncPassed \u0026\u0026 tangentFixturesPassed \u0026\u0026')\\ns=s.replace('\\\"shadowBatch\\\":shadowBatch?.statistics ?? [:],','\\\"shadowBatch\\\":shadowBatch?.statistics ?? dirtWorld.town.shadowBatchDiagnostics,\\\"shadowBatchSyncPassed\\\":shadowBatchSyncPassed,')\\nopen(p,'w').write(s)\\np='scripts/rendering/test-sustained-performance.py';s=open(p).read().replace(\\\"'--benchmark-shadow-batch']\\\",\\\"'--benchmark-shadow-batch','--benchmark-shadow-batch-live']\\\");open(p,'w').write(s)\\nPY\\ngit diff --check\",\"workdir\":\"/Users/thomi/Projects/entireio-marvin\",\"max_output_tokens\":1000}));\n","internal_chat_message_metadata_passthrough":{"create_time":1791009682.610861,"turn_id":"01a10063-c779-76d1-8a4c-5f724176c155"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_1TH8OnO62L49nxK8fYTBYNzl","id":"ctco_01a1007f-edf3-7e51-bc64-30ab71a3867d","internal_chat_message_metadata_passthrough":{"create_time":1791009746.41915,"turn_id":"01a10063-c77